# Copia este archivo como .env.local (local) o pega estas variables en el hosting.
# Nunca subas .env.local ni la clave del operador a GitHub.

# --- Entorno ---
ENV_MODE=sandbox
# En el hosting: NODE_ENV=production (escucha en 0.0.0.0, cookies seguras, exige secretos propios).
NODE_ENV=development
# HOST=0.0.0.0
# PORT=3000

# --- Base de datos ---
PERSISTENCE=postgres
DATABASE_URL=postgresql://proofly:proofly_secret@localhost:55432/proofly_db
# true en bases gestionadas (Render/Railway con URL externa).
DATABASE_SSL=false

# --- Secretos de la app (mínimo 32 caracteres, distintos en cada entorno) ---
SERVER_HMAC_SECRET=
PROOFLY_SECURE_COOKIE=false

# --- Red y contratos (Ethereum Sepolia) ---
BLOCKCHAIN_ADAPTER=viem
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PROOFLY_OPERATIONS_ADDRESS=0xdA03f2AfBeB77a47843466252e04d7dA284DaBA3
PROOFLY_KYC_REGISTRY_ADDRESS=0x407B83F792895E2d88B8b96e1A640b0Fa3A2De11
MOCK_USDC_ADDRESS=0x776991CA67ec0DAb8907FD84d08143BcA2050C0b
PROOFLY_FINANCIER_ADDRESS=
DEMO_COP_PER_USDC=4000

# --- Frontend (se leen al compilar: deben existir en el build) ---
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_PROOFLY_OPERATIONS_ADDRESS=0xdA03f2AfBeB77a47843466252e04d7dA284DaBA3
VITE_MOCK_USDC_ADDRESS=0x776991CA67ec0DAb8907FD84d08143BcA2050C0b

# --- Habilitación automática de wallets nuevas (la ejecuta el worker) ---
# mUSDC de prueba que recibe una wallet verificada si tiene menos de 100.
DEMO_ONBOARD_MUSDC=1000
# ETH de Sepolia para gas (en wei). 0 desactiva el envío. 10000000000000000 = 0,01 ETH.
DEMO_ONBOARD_ETH_WEI=10000000000000000

# --- Solo el worker. Nunca lo subas ni lo pongas en el servicio web. ---
OPERATOR_PRIVATE_KEY=
