{
  "mcpServers": {
    "playwright": {
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "--yes",
        "@playwright/mcp@0.0.84",
        "--browser",
        "chrome",
        "--headless",
        "--isolated",
        "--sandbox",
        "--no-webmcp",
        "--output-dir",
        ".kiro/artifacts/playwright"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      },
      "disabled": false,
      "autoApprove": [
        "browser_close",
        "browser_resize",
        "browser_console_messages",
        "browser_handle_dialog",
        "browser_fill_form",
        "browser_navigate",
        "browser_navigate_back",
        "browser_network_requests",
        "browser_press_key",
        "browser_take_screenshot",
        "browser_snapshot",
        "browser_click",
        "browser_drag",
        "browser_hover",
        "browser_select_option",
        "browser_tabs",
        "browser_type",
        "browser_wait_for"
      ],
      "disabledTools": [
        "browser_evaluate",
        "browser_run_code",
        "browser_run_code_unsafe",
        "browser_file_upload",
        "browser_drop",
        "browser_install"
      ]
    }
  }
}
